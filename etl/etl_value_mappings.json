  "crossFieldRules": [
    {
      "when": "atribut 'transmisie' cu valoare de tractiune (spate/fata/x-drive)",
      "then": "ruteaza la drivetrain, nu la gearbox — 3 cazuri in date"
    },
    {
      "when": "atribute booleene de climatizare (climatronic etc.) = true",
      "then": "seteaza airConditioning la valoarea enum corespunzatoare din sinonime"
    },
    {
      "when": "senzori parcare STRING: 'da'",
      "then": "feature senzori-parcare"
    },
    {
      "when": "senzori parcare STRING: contine fata+spate",
      "then": "features senzori-parcare-fata + senzori-parcare-spate"
    },
    {
      "when": "senzori parcare STRING: contine camera/360",
      "then": "+ camera-marsarier sau camera-360"
    },
    {
      "when": "pilot automat STRING 'da'",
      "then": "feature pilot-automat"
    },
    {
      "when": "istoric service: 'da'",
      "then": "serviceBook=true; altele -> extraSpecs"
    },
    {
      "when": "tapiterie piele / interior piele / interior din piele / scaune piele (boolean) = true",
      "then": "upholstery=LEATHER daca e null"
    },
    {
      "when": "tapiterie alcantara/stofa/mixta (boolean VIA) = true",
      "then": "upholstery corespunzator daca e null"
    },
    {
      "when": "garantie BOOLEAN true",
      "then": "feature garantie-inclusa; garantie NUMBER -> warrantyMonths"
    },
    {
      "when": "price fix v1 != null si EAV pret != null si difera",
      "then": "price fix castiga; EAV pret -> raport reconciliere"
    }
  ],
