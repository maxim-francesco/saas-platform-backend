// ============================================================
// SCHEMA V2 — SaaS Auto Dealerships (propunere design, M3)
// Proiectată pe datele reale din inventarul M2 (28 tenants whitelist)
// EAV (Category/Attribute/AttributeGroup/AttributeValue) = ELIMINAT
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== TENANT & USERS =====================

model Business {
  id                  String     @id @default(cuid())
  name                String     @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  bannerUrl           String?
  listingUrlPattern   String?
  // --- Date firmă (identitate juridică & contact, folosite în oferte/contracte) ---
  companyPhone    String?
  companyEmail    String?
  companyAddress  String?
  companyCui      String?   // CUI / CIF
  companyRegCom   String?   // Nr. Registrul Comerțului
  companyLegalRep String?   // Reprezentant legal
  companyLogoUrl  String?   // rezervat fazei 2 (upload logo)
  bestAutoApiKey      String?
  autovitClientId     String?
  autovitClientSecret String?
  autovitUsername     String?
  autovitPassword     String?
  users               User[]
  listings            Listing[]
  messages            Message[]
  reviews             Review[]
  views               View[]
  blogPosts           BlogPost[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  tokenVersion Int      @default(0)
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
}

// ============ DICȚIONARE GLOBALE (administrate din Super Admin) ============

model Make {
  id          String     @id @default(cuid())
  name        String     @unique // "BMW"
  slug        String     @unique // "bmw" — identic cu codul Autovit
  autovitCode String?    @unique // redundant cu slug azi, dar decuplat pt viitor
  models      CarModel[]
  listings    Listing[]
}

model CarModel {
  id          String    @id @default(cuid())
  name        String // "Seria 3"
  slug        String // "seria-3"
  makeId      String
  make        Make      @relation(fields: [makeId], references: [id])
  autovitCode String?
  listings    Listing[]

  @@unique([makeId, slug])
}

model Feature {
  id       String       @id @default(cuid())
  name     String // "Scaune încălzite"
  slug     String       @unique // "scaune-incalzite"
  group    FeatureGroup
  listings Listing[] // m2m implicit (tabela _FeatureToListing)
}

// ===================== LISTING (VEHICUL) =====================

model Listing {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  status      ListingStatus @default(AVAILABLE)
  title       String // pre-generat din marcă+model+variant+an, rămâne editabil
  slug        String?
  description String?       @db.Text

  // --- Identitate vehicul ---
  makeId              String?
  make                Make?     @relation(fields: [makeId], references: [id])
  modelId             String?
  model               CarModel? @relation(fields: [modelId], references: [id])
  variant             String? // "320d xDrive M Sport" — text liber
  year                Int? // an fabricație
  vin                 String?
  firstRegistrationAt DateTime? // prima înmatriculare (precizie lună)
  countryOfOrigin     String?   @db.VarChar(2) // ISO-3166-1: DE, IT, FR, RO...
  registeredInRo      Boolean? // înmatriculat(ă) în RO

  // --- Tehnic ---
  mileage         Int?
  fuelType        FuelType?
  gearbox         GearboxType?
  drivetrain      Drivetrain?
  bodyType        BodyType?
  engineCapacity  Int? // cm³
  powerHp         Int? // CP
  pollutionNorm   PollutionNorm?
  co2Emissions    Int? // g/km
  color           CarColor?
  colorDetail     String? // "Gri Selenit metalizat" — textul original al dealerului
  upholstery      Upholstery?
  airConditioning AirConditioning?
  doors           Int?
  seats           Int?

  // --- Istoric & comercial ---
  vatDeductible  Boolean? // TVA deductibil — foarte folosit (427 în v1)
  noAccidents    Boolean?
  serviceBook    Boolean? // carte service
  firstOwner     Boolean?
  ownerCount     Int?
  warrantyMonths Int?

  // --- Preț & intern (păstrate 1:1 din v1) ---
  price         Float? // prețul public
  purchasePrice Float?
  sellingPrice  Float?
  otherCosts    Float?
  soldAt        DateTime?
  internalNotes String?

  // --- Integrare & media (păstrate din v1) ---
  youtubeVideoId String?
  autovitId      BigInt?
  autovitStatus  String? // "active" | "inactive" | null

  // --- Supapa de siguranță ETL ---
  extraSpecs Json? // orice atribut v1 nemapat curat; de golit/eliminat post-migrare

  features Feature[]
  images   ListingImage[]
  views    View[]
  messages Message[]

  @@index([businessId, status])
  @@index([price])
  @@index([mileage])
  @@index([year])
  @@index([makeId])
  @@index([modelId])
  @@index([fuelType])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  listingId String
  order     Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ============== NESCHIMBATE FUNCȚIONAL FAȚĂ DE V1 ==============

model Message {
  id         String            @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String
  isRead     Boolean           @default(false)
  createdAt  DateTime          @default(now())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id])
  type       MessageType       @default(GENERAL)
  status     LeadStatus        @default(NEW)
  lostReason LostReason?
  reminderAt DateTime?
  listingId  String?
  listing    Listing?          @relation(fields: [listingId], references: [id])
  activities MessageActivity[]
}

model View {
  id         String   @id @default(cuid())
  viewedAt   DateTime @default(now())
  businessId String
  listingId  String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  name       String
  rating     Int
  text       String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, isApproved])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String
  excerpt     String
  content     String   @db.Text
  category    String
  categoryKey String
  readTime    String
  coverImage  String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  @@unique([slug, businessId])
  @@index([businessId, isPublished])
}

// ===================== ENUMS =====================

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ListingStatus {
  INCOMING // "Sosește în curând" — dealerii o inventaseră deja (VIITOR/In Curand)
  AVAILABLE
  RESERVED
  SOLD
}

enum FuelType {
  PETROL
  DIESEL
  PETROL_LPG
  LPG
  HYBRID
  PLUGIN_HYBRID
  MILD_HYBRID
  ELECTRIC
}

enum GearboxType {
  MANUAL
  AUTOMATIC
}

enum Drivetrain {
  FWD // față
  RWD // spate
  AWD // integrală / 4x4
}

enum BodyType {
  SUV
  SEDAN // Limuzina / Berlina / Limousine
  HATCHBACK
  BREAK // Combi / Kombi
  COUPE
  CABRIO
  MONOVOLUM
  VAN
  PICKUP
}

enum PollutionNorm {
  NON_EURO
  EURO_1
  EURO_2
  EURO_3
  EURO_4
  EURO_5
  EURO_6
  EURO_6D
}

enum CarColor {
  BLACK
  GREY
  WHITE
  BLUE
  RED
  BROWN
  SILVER
  ORANGE
  GREEN
  PURPLE
  GOLD
  BEIGE
  YELLOW
  OTHER
}

enum Upholstery {
  FABRIC // textil / stofă / pânză
  VELOUR
  LEATHER
  PARTIAL_LEATHER // mixt / semipiele / piele-velur
  ALCANTARA
}

enum AirConditioning {
  NONE
  MANUAL // "aer condiționat"
  AUTOMATIC // climatronic / automată
  DUAL_ZONE // dublu climatronic
  TRI_ZONE
  QUAD_ZONE
}

enum FeatureGroup {
  SAFETY
  COMFORT
  MULTIMEDIA
  EXTERIOR
  SERVICES
}

model MessageActivity {
  id        String       @id @default(cuid())
  messageId String
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind      ActivityKind
  fromValue String?
  toValue   String?
  body      String?
  authorId  String?
  createdAt DateTime     @default(now())
}

enum MessageType {
  GENERAL
  STOCK
  ORDER
  BUYBACK
}

enum LeadStatus {
  NEW
  CONTACTED
  VIEWING
  OFFER
  WON
  LOST
}

enum LostReason {
  PRICE
  BOUGHT_ELSEWHERE
  UNREACHABLE
  NOT_SERIOUS
  OTHER
}

enum ActivityKind {
  CREATED
  STATUS_CHANGED
  TYPE_CHANGED
  NOTE
  REMINDER_SET
  REMINDER_CLEARED
  LINKED_LISTING
}
